Options -MultiViews

RewriteEngine On
RewriteBase /cbmdl/

# Deny direct access to sensitive files and directories
<FilesMatch "(^\.env|^\.git|schema\.sql|error_log|config\.php)$">
    Require all denied
</FilesMatch>

# Redirect index.php to root URL (for GET requests only without query params)
RewriteCond %{REQUEST_METHOD} GET
RewriteCond %{QUERY_STRING} ^$
RewriteCond %{THE_REQUEST} \s/+cbmdl/index\.php[?\s] [NC]
RewriteRule ^index\.php$ /cbmdl/ [R=301,L]

# Route all requests to index.php if physical file/directory doesn't exist
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)$ index.php [QSA,L]